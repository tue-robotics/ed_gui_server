<?xml version="1.0"?>
<class_libraries>
  <!-- ROS 2 pluginlib resolves this itself by searching lib/ and lib/ed_gui_server/, so the path is
       the bare library name: no "lib" prefix and no directory (a ROS 1 "lib/libfoo" path is not
       found). -->
  <library path="ed_gui_server_plugin">
    <class name="ed_gui_server/gui_server" type="GUIServerPlugin" base_class_type="ed::Plugin">
      <description>Plugin to expose ROS interfaces to vizualize the WM.</description>
    </class>
  </library>
</class_libraries>
