<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ed_gui_server</name>
  <version>0.0.0</version>
  <description>Plugin for the ED world model to provide ROS interfaces for RViz and other visualization apps</description>

  <maintainer email="MatthijsBurgh@outlook.com">Matthijs van der Burgh</maintainer>

  <license>BSD</license>

  <author email="s.v.d.dries@tue.nl">Sjoerd van den Dries</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>ed</depend>
  <depend>ed_gui_server_interfaces</depend>
  <depend>geolib2</depend>
  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rgbd</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tue_config</depend>
  <depend>urdf</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_clang_tidy</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>clang-format-21</test_depend>
  <test_depend>clang-tidy-21</test_depend>
  <!-- ed drags PCL's -fopenmp onto our translation units; clang-tidy runs a clang frontend and
       needs its own omp.h, or Eigen fails to include it and the lint results are meaningless. -->
  <test_depend>libomp-21-dev</test_depend>
  <test_depend>tue_lint_config</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
